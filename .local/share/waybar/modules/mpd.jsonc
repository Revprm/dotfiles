{
  "mpd": {
    // CORE CONFIG
    "interval": 2,
    "unknown-tag": "N/A",
    "max-length": 40,

    // INTERACTIVITY
    "on-click": "mpc toggle",
    "on-scroll-up": "mpc next",
    "on-scroll-down": "mpc prev",
    // REPLACE 'kitty' WITH YOUR ACTUAL TERMINAL
    "on-click-right": "kitty -e rmpc",

    // FORMATTING
    "format": "{stateIcon} {artist} - {title}  {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}",
    "format-disconnected": "Disconnected ",
    "format-paused": "{stateIcon} {artist} - {title} ",
    "format-stopped": "{stateIcon} Stopped ",

    // ICONS
    "state-icons": {
      "paused": "",
      "playing": ""
    },
    "consume-icons": {
      "on": " "
    },
    "random-icons": {
      "off": "<span color=\"#6e6a86\"></span> ",
      "on": " "
    },
    "repeat-icons": {
      "on": " "
    },
    "single-icons": {
      "on": "1 "
    },

    // TOOLTIP (Fixed to remove MPD references)
    "tooltip-format": "<b>RMPC</b>\n{artist} - {album}\n({elapsedTime:%M:%S} / {totalTime:%M:%S})\n\nUp next: {nextArtist} - {nextTitle}",
    "tooltip-format-disconnected": "RMPC (disconnected)"
  }
}
