//   --// waybar config generated by old the wbarconfgen script //--   //
{
  "layer": "top",
  "output": ["*"],
  "height": 10,
  "exclusive": true,
  "passthrough": false,
  "reload_style_on_change": true,
  "include": [
    "$XDG_CONFIG_HOME/waybar/modules/*json*",
    "$XDG_CONFIG_HOME/waybar/includes/includes.json"
  ],

  "modules-left": ["group/pill#left1"],
  "group/pill#left1": {
    "orientation": "inherit",
    "modules": ["hyprland/workspaces", "hyprland/window"]
  },
  "modules-center": ["group/pill#center"],
  "group/pill#center": {
    "orientation": "inherit",
    "modules": ["clock", "custom/dunst"]
  },
  "modules-right": [
    "group/pill#right1",
    "group/pill#right2",
    "group/pill#right3",
    "group/pill#right4"
  ],
  "group/pill#right1": {
    "orientation": "inherit",
    "modules": ["cpu", "memory", "custom/cpuinfo"]
  },
  "group/pill#right2": {
    "orientation": "inherit",
    "modules": [
      "backlight",
      "network",
      "pulseaudio",
      "pulseaudio#microphone",
      "custom/updates"
    ]
  },
  "group/pill#right3": {
    "orientation": "inherit",
    "modules": ["bluetooth", "battery", "custom/sensorsinfo"]
  },
  "group/pill#right4": {
    "orientation": "inherit",
    "modules": [
      "custom/theme",
      "custom/wbar",
      "custom/cliphist",
      "custom/hyde-menu",
      "custom/power"
    ]
  }
}
